#!/bin/bash
set -e

case "${1}" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop agent_chiffreur.service 2>/dev/null || true
            systemctl disable agent_chiffreur.service 2>/dev/null || true
        fi
        ;;
esac

exit 0
